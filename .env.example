# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5177,http://localhost:8030

# --- Database ---
POSTGRES_DB=languorino
POSTGRES_USER=languorino
POSTGRES_PASSWORD=languorino
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis: cache Django (db 0) e coda Celery (db 1) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Auth ---
# Vita dei token JWT (secondi)
ACCESS_TOKEN_LIFETIME=900
REFRESH_TOKEN_LIFETIME=1209600
# In dev il cookie di refresh non e' Secure (niente https su localhost)
REFRESH_COOKIE_SECURE=0
REFRESH_COOKIE_SAMESITE=Lax
# Nome del cookie di refresh. I cookie ignorano la porta: ogni progetto in
# locale usa il suo, altrimenti i login si sovrascrivono.
REFRESH_COOKIE_NAME=languorino_refresh

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@languorino.local

# --- cornhub: login unico e AI (ADR 0021) ---
# In locale gira il compose di cornhub (http://localhost:8095, backend sulla
# 8096). Client e token: dal repo cornhub
#   docker compose exec backend python manage.py register_app languorino \
#     --name languorino --url http://localhost:5177 --extra-redirect http://localhost:8030/api/auth/sso/callback
CORNHUB_URL=http://localhost:8095
CORNHUB_INTERNAL_URL=http://host.docker.internal:8096
CORNHUB_APP_SLUG=languorino
CORNHUB_CLIENT_ID=
CORNHUB_CLIENT_SECRET=
# Vuoto: AI spenta.
CORNHUB_APP_TOKEN=
# Il ritorno dal login di cornhub arriva all'API (in produzione = frontend).
API_PUBLIC_URL=http://localhost:8030
# Scontrino (ADR 0026): in locale la sua API sull'host; vuoto = niente
# "Manda a Scontrino". In produzione http://scontrino-backend:8000.
SCONTRINO_INTERNAL_URL=http://host.docker.internal:8040
SCONTRINO_URL=http://localhost:5178

# --- Frontend ---
FRONTEND_BASE_URL=http://localhost:5177
VITE_API_BASE_URL=http://localhost:8030

# --- Errori ---
# Segnalazione degli errori a GlitchTip (protocollo Sentry) da backend, worker
# e beat (SENTRY_DSN) e dal browser (VITE_SENTRY_DSN, letta alla build). Vuote
# = spente. In sviluppo restano vuote.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
VITE_SENTRY_DSN=
