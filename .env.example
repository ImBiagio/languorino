# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5177,http://localhost:8030

# --- Database ---
POSTGRES_DB=languorino
POSTGRES_USER=languorino
POSTGRES_PASSWORD=languorino
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis: cache Django (db 0) e coda Celery (db 1) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Auth ---
# Vita dei token JWT (secondi)
ACCESS_TOKEN_LIFETIME=900
REFRESH_TOKEN_LIFETIME=1209600
# In dev il cookie di refresh non e' Secure (niente https su localhost)
REFRESH_COOKIE_SECURE=0
REFRESH_COOKIE_SAMESITE=Lax
# Nome del cookie di refresh. I cookie ignorano la porta: ogni progetto in
# locale usa il suo, altrimenti i login si sovrascrivono.
REFRESH_COOKIE_NAME=languorino_refresh
# Verifica email obbligatoria alla registrazione
REQUIRE_EMAIL_VERIFICATION=0

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@languorino.local

# --- LLM ---
# Chiave Gemini (Google AI Studio). Vuota: le funzioni con l'LLM restano spente.
GEMINI_API_KEY=
# Modello principale e riserve (ADR 0005); vuoti = i default dei settings.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# Immagini delle ricette: richiedono la fatturazione attiva sulla chiave.
GEMINI_MODEL_IMAGE=gemini-2.5-flash-image
AI_IMAGES_PER_DAY=20

# --- Frontend ---
FRONTEND_BASE_URL=http://localhost:5177
VITE_API_BASE_URL=http://localhost:8030
