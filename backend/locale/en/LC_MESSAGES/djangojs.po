#, javascript-format
msgid ""
"Pannocchie rimaste oggi: %s su %s. Quota gratuita per le funzioni AI piccole."
msgstr "Corn cobs left today: %s of %s. Free quota for small AI features."

msgid "Usa la tua chiave API"
msgstr "Uses your API key"

msgid "Apri cornhub"
msgstr "Open cornhub"

#, javascript-format
