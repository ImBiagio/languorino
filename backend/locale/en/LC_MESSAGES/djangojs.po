msgstr "You cook for %s"

msgid "Ecco cosa ho capito: controlla e salva"
msgstr "Here's what I understood: check and save"

msgid "Ho capito"
msgstr "Got it"

msgid "Niente di nuovo da salvare."
msgstr "Nothing new to save."

msgid "Basta così"
msgstr "That's enough"

msgid "Salva e inizia"
msgstr "Save and start"

msgid "Salva nel profilo"
msgstr "Save to profile"

msgid "uova"
msgstr "eggs"

msgid "pasta"
msgstr "pasta"

msgid "riso"
msgstr "rice"

msgid "zucchine"
msgstr "courgettes"

msgid "pomodori"
msgstr "tomatoes"

msgid "cipolla"
msgstr "onion"

msgid "patate"
msgstr "potatoes"

msgid "mozzarella"
msgstr "mozzarella"

msgid "petto di pollo"
msgstr "chicken breast"

