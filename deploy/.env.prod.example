# Modello del .env di produzione (~/languorino/.env sul server). I valori veri
# stanno nel vault, nota "Credenziali e accessi". Mai committare il .env.
DJANGO_SETTINGS_MODULE=config.settings.prod
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=languor.inoo.it,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://languor.inoo.it
FRONTEND_BASE_URL=https://languor.inoo.it

POSTGRES_DB=languorino
POSTGRES_USER=languorino
# openssl rand -hex 24
POSTGRES_PASSWORD=

REFRESH_COOKIE_SAMESITE=Lax
# SMTP di Brevo, lo stesso account degli altri progetti (dominio inoo.it
# autenticato). Login e SMTP key in Credenziali e accessi (vault di cinemino).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Languorino <messagg@inoo.it>

# cornhub: login unico e AI (ADR 0021). Valori da `manage.py register_app
# languorino --name languorino --url https://languor.inoo.it` sul server di
# cornhub; in Credenziali e accessi.
CORNHUB_URL=https://cornhub.it
CORNHUB_INTERNAL_URL=http://cornhub-backend:8000
CORNHUB_APP_SLUG=languorino
CORNHUB_CLIENT_ID=
CORNHUB_CLIENT_SECRET=
CORNHUB_APP_TOKEN=

GUNICORN_WORKERS=3
LOG_LEVEL=INFO

# --- Errori ---
# Segnalazione degli errori a GlitchTip (protocollo Sentry) da backend, worker
# e beat. Vuoto = spenta. # Il DSN vero in Credenziali e accessi.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
