# Modello del .env di produzione (~/languorino/.env sul server). I valori veri
# stanno nel vault, nota "Credenziali e accessi". Mai committare il .env.
DJANGO_SETTINGS_MODULE=config.settings.prod
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=languor.inoo.it,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://languor.inoo.it
FRONTEND_BASE_URL=https://languor.inoo.it

POSTGRES_DB=languorino
POSTGRES_USER=languorino
# openssl rand -hex 24
POSTGRES_PASSWORD=

REFRESH_COOKIE_SAMESITE=Lax
REQUIRE_EMAIL_VERIFICATION=1
# Codice di invito: se impostato ci si registra solo conoscendolo (il valore
# vero in Credenziali e accessi). Vuoto o commentato = registrazione aperta.
# SIGNUP_CODE=
# SMTP di Brevo, lo stesso account degli altri progetti (dominio inoo.it
# autenticato). Login e SMTP key in Credenziali e accessi (vault di cinemino).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Languorino <messagg@inoo.it>

# Gemini (ADR 0005): la stessa chiave del .env di sviluppo, in Credenziali e accessi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
GEMINI_MODEL_FAST=gemini-flash-lite-latest
# 1 quando il progetto Gemini e' al livello 2: priorita' per le funzioni interattive.
GEMINI_PRIORITY=0
GEMINI_MODEL_LIVE=gemini-3.1-flash-live-preview
# Immagini delle ricette (ADR 0011): serve la fatturazione attiva sulla chiave.
GEMINI_MODEL_IMAGE=gemini-2.5-flash-image
AI_IMAGES_PER_DAY=20
# Tetto alla spesa: chiamate riuscite a Gemini al giorno, per utente e per
# tutta l'app (immagini comprese), e conversazioni a voce per utente. Oltre il
# tetto le funzioni con l'AI rispondono 429 fino a mezzanotte. 0 = nessun tetto.
AI_CALLS_PER_DAY=400
AI_CALLS_PER_DAY_GLOBAL=2000
AI_LIVE_SESSIONS_PER_DAY=20

GUNICORN_WORKERS=3
LOG_LEVEL=INFO

# --- Errori ---
# Segnalazione degli errori a GlitchTip (protocollo Sentry) da backend, worker
# e beat. Vuoto = spenta. # Il DSN vero in Credenziali e accessi.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
